{
  "name": "fluent-feeds",
  "productName": "Fluent Feeds",
  "version": "1.0.0",
  "description": "A fast, native-feeling RSS reader for Windows 11",
  "main": "main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win --x64 --arm64"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.example.fluentfeeds",
    "productName": "Fluent Feeds",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
